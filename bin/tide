#!/bin/sh
# Launcher for a git clone: works through symlinks, so it can live in ~/.local/bin.
src=$0
while [ -L "$src" ]; do
    dir=$(cd "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    case $src in
        /*) ;;
        *) src=$dir/$src ;;
    esac
done
here=$(cd "$(dirname "$src")/.." && pwd)
exec python3 "$here/main.py" "$@"
